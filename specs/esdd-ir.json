  "claims": [
    { "id": "CLAIM-01", "state": "UE01_AGENTS_HOME", "description": "Agents Home renders Host pill, Search, Filter pills, Pinned & Project-grouped conversations, Liquid Glass Tab Bar, and Compose FAB" },
    { "id": "CLAIM-02", "state": "UE02_DISPLAY_OPTIONS", "description": "Display Options sheet renders Group By, Sort Conversations popover menu, Auto Pin / Archived Only toggles, and Mark All as Read" },
    { "id": "CLAIM-03", "state": "UE03_CONTEXT_MENU_PIN", "description": "Context Menu renders rich Plan preview card, Pin/Unread/Rename/Move/Archive/Delete actions, and Swipe Pin/Archive shortcuts" },
    { "id": "CLAIM-04", "state": "UE04_PROJECT_DETAIL", "description": "Project Detail renders ledger-svc metadata pills, New Conversation CTA, Active/Archived/Automations tabs, and This Project tools" },
    { "id": "CLAIM-05", "state": "UE05_CREATE_PROJECT", "description": "New Project sheet supports MacBook Pro vs Cloud runtime, GitHub vs Drive source, repo search, worktree config, and Create Project CTA" },
    { "id": "CLAIM-06", "state": "UE06_AUTOMATIONS", "description": "Automations hub renders NL quick-create bar, Scheduled cards with Next/Last Run stats, Always On PR triage, and Paused Resume action" },
    { "id": "CLAIM-07", "state": "UE07_CHAT_AND_COMPOSER", "description": "Chat screen renders +128 -14 badge, Thought for 14s, Plan card, 7-segment Task card, Face ID Allow/Deny command card, and Composer with @chip, Mode, Model, Mic, and Send" },
    { "id": "CLAIM-08", "state": "UE08_ADD_CONTEXT", "description": "Add Context sheet renders 5 category tiles (Files, Folder, Mentions, Actions, Skills), multi-select rows, and Add to message CTA" },
    { "id": "CLAIM-09", "state": "UE09_MODEL_AND_MODE", "description": "Model & Mode sheet renders Planning/Fast cards, Gemini 3.1 Pro / 3.8 Flash / Claude Opus 5.5 / Sonnet 5.5 rows, and Agent persona pills" },
    { "id": "CLAIM-10", "state": "UE10_STRUCTURED_QUESTION", "description": "Structured Question card renders 3-step stepper pills, multi-select checkboxes, Something else write-in, Back/Next buttons, and freeform composer" },
    { "id": "CLAIM-11", "state": "UE11_PLAN_REVIEW", "description": "Implementation Plan review renders paused amber banner, MODIFY/NEW badges, pending comment card, text selection Comment/Copy callout, and Proceed / Send 2 comments bar" },
    { "id": "CLAIM-12", "state": "UE12_TURN_DIFF_REVIEW", "description": "Turn Diff review renders Turn 1..3/All pills, File 1 of 4 pager, Revert hunk, syntax diff lines, Line 29 comment composer, and Viewed / Revert file / Accept file bar" },
    { "id": "CLAIM-13", "state": "UE13_LIVE_ACTIVITY_SPEC", "description": "Live Activity & Dynamic Island renders all 7 variants: Compact Running/Waiting/Done, Minimal Ring, Expanded Running/Waiting (Face ID), and Lock Screen Multi-Agent card" }
  ]
